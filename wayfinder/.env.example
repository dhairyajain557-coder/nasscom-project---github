# Copy this file to .env and fill in ONE of the two options below.
# With neither, the app runs in demo mode (offline sample itineraries).

# Option A: Vertex AI on Google Cloud (the course path)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Gemini API key from Google AI Studio (quickest to try)
# GEMINI_API_KEY=your-api-key

GEMINI_MODEL=gemini-2.5-flash

# Force offline demo content regardless of the settings above
# DEMO_MODE=true

PORT=8080
